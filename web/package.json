{
  "name": "macroquant-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "data:generate": "python3 ../generate_static_macro_json.py",
    "data:generate:five-asset": "python3 ../strategies/five_asset_macro_cta/run_live_cycle.py --mode auto --web-output",
    "data:generate:five-asset:bitget-plan": "python3 ../strategies/five_asset_macro_cta/run_bitget_demo_cycle.py --mode auto",
    "build": "next build",
    "build:cf": "node scripts/ensure-static-data.mjs && next build",
    "build:static": "npm run data:generate && npm run build:cf",
    "start": "next start",
    "lint": "next lint",
    "cf:deploy": "npm run data:generate:five-asset && npm run build:cf && wrangler pages deploy out --project-name ${CF_PAGES_PROJECT_NAME:-macroquant} --commit-dirty=true",
    "cf:deploy:fresh": "npm run data:generate && npm run data:generate:five-asset && npm run cf:deploy"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.546.0",
    "next": "^15.5.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "recharts": "^3.1.2"
  },
  "devDependencies": {
    "@types/node": "^22.18.1",
    "@types/react": "^19.1.11",
    "@types/react-dom": "^19.1.7",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.34.0",
    "eslint-config-next": "^15.5.2",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.2",
    "wrangler": "^4.35.0"
  }
}
